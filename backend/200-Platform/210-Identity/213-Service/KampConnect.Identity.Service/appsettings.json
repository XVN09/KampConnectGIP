{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IdentityDb": ""
  },
  "Identity": {
    "Issuer": "",
    "ApiAudience": "kampconnect-api",
    "RequireVerifiedEmail": true,
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "MinimumPasswordLength": 12,
    "EmailVerificationLifetimeHours": 24,
    "PasswordResetLifetimeMinutes": 60,
    "EmailVerificationUrl": "https://kampconnect.be/verify-email?token={0}",
    "PasswordResetUrl": "https://kampconnect.be/reset-password?token={0}",
    "Certificates": {
      "SigningPath": "",
      "SigningPassword": "",
      "EncryptionPath": "",
      "EncryptionPassword": ""
    }
  }
}
