{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "LogPath": "logs",
    "LogFileName": "clientregistration.log",
    "MaxFiles": 5,
    "MaxFileSizeInKB": 1024,
    "UseConsoleLogging": true
  },
  "ConnectionStrings": {
    "IdentityDb": ""
  },
  "Registration": {
    "ApplyMigrations": false,
    "Scopes": {},
    "Clients": {
      "kampconnect-app": {
        "DisplayName": "KampConnect App",
        "ClientType": "public",
        "ApplicationType": "native",
        "RequirePkce": true,
        "GrantTypes": [ "authorization_code", "refresh_token" ],
        "RedirectUris": [ "be.kampconnect.app:/callback" ],
        "PostLogoutRedirectUris": [ "be.kampconnect.app:/logout" ],
        "Scopes": [ "openid", "email", "roles", "offline_access" ]
      }
    },
    "Roles": {
      "platform_admin": {
        "Name": "Platformbeheerder",
        "Description": "Beheerder van KampConnect (zonder tenant)",
        "IsPlatformRole": true
      },
      "organisation_admin": {
        "Name": "Organisatiebeheerder",
        "Description": "Beheert een organisatie en haar kampen"
      },
      "staff": {
        "Name": "Medewerker",
        "Description": "Kampleiding en animatoren"
      },
      "guardian": {
        "Name": "Ouder/voogd",
        "Description": "Ouder of voogd van een deelnemer"
      }
    }
  }
}
